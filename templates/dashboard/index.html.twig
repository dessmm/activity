{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>Welcome to the Dashboard</h1>
        {% if role == 'admin' %}
            <p>You are logged in as Admin. You have full access.</p>
        {% else %}
            <p>You are logged in as Regular User. Limited access granted.</p>
        {% endif %}
    </div>
{% endblock %}
